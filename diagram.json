{
  "version": 1,
  "author": "Alejo leonel maidana",
  "editor": "wokwi",
  "serialMonitor": {
    "display": "always"
  },
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -140,
      "left": 100,
      "attrs": {}
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": -90,
      "left": -100,
      "attrs": { "color": "red" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 20,
      "left": -120,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-servo",
      "id": "servo1",
      "top": 140,
      "left": 180,
      "attrs": {}
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "dht1:VCC", "esp:3V3", "red", [ "v0" ] ],
    [ "dht1:SDA", "esp:4", "gold", [ "v0" ] ],
    [ "dht1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "esp:15", "led1:A", "red", [ "v0" ] ],
    [ "led1:C", "r1:1", "black", [ "v0" ] ],
    [ "r1:2", "esp:GND.2", "black", [ "v0" ] ],
    [ "servo1:PWM", "esp:13", "orange", [ "v0" ] ],
    [ "servo1:V+", "esp:5V", "red", [ "v0" ] ],
    [ "servo1:GND", "esp:GND.3", "black", [ "v0" ] ]
  ],
  "dependencies": {}
}
